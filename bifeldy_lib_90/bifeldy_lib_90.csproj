<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>bifeldy_lib_90</RootNamespace>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <SelfContained>true</SelfContained>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <IlcMaxDegreeOfParallelism>1</IlcMaxDegreeOfParallelism>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
        <!-- Build Info -->
        <Version>1.0.0.0</Version>
        <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ss:fffZ"))</SourceRevisionId>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <None Update="bifeldy_lib_90.db">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="_assets\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="FormatOnBuild" BeforeTargets="BeforeBuild">
        <Message Text="Running dotnet format on $(ProjectFileName)..." Importance="high" />
        <Exec Command="dotnet format &quot;$(ProjectPath)&quot; --no-restore" ContinueOnError="false" />
    </Target>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <WarningsAsErrors>$(WarningsAsErrors);NU1605;CS1998;CS8600;CS8603;CS8618;IDE0002;IDE0005;IDE0007;IDE0009;IDE0011;IDE0008;IDE0058;IDE2003;IDE0301</WarningsAsErrors>
        <NoWarn>1701;1702;PBN0013;PBN0014;IDE0022;IDE0046;IDE0078;IDE0059;IDE0060;IDE0270</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <WarningsAsErrors>$(WarningsAsErrors);NU1605;CS1998;CS8600;CS8603;CS8618;IDE0002;IDE0005;IDE0007;IDE0009;IDE0011;IDE0008;IDE0058;IDE2003;IDE0301</WarningsAsErrors>
        <NoWarn>1701;1702;PBN0013;PBN0014;IDE0022;IDE0046;IDE0078;IDE0059;IDE0060;IDE0270</NoWarn>
        <DebugType>none</DebugType>
        <StripSymbols>true</StripSymbols>
    </PropertyGroup>

    <ItemGroup>
        <RdXmlFile Include="rd.xml" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ChoETL.JSON" Version="1.2.1.71" />
        <PackageReference Include="Confluent.SchemaRegistry.Serdes.Json" Version="2.12.0" />
        <PackageReference Include="Cronos" Version="0.11.1" />
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="Dapper.AOT" Version="1.0.48" />
        <PackageReference Include="FluentFTP" Version="39.4.0" />
        <PackageReference Include="Haukcode.WkHtmlToPdfDotNet" Version="1.5.95" />
        <PackageReference Include="Helmet" Version="1.0.4" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.3.0" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.11" />
        <PackageReference Include="MimeKit" Version="4.15.1" />
        <PackageReference Include="NCrontab" Version="3.4.0" />
        <PackageReference Include="Npgsql" Version="9.0.5" />
        <PackageReference Include="ProDotNetZip" Version="1.20.0" />
        <PackageReference Include="QRCoder" Version="1.7.0" />
        <PackageReference Include="ReportViewerCore.NETCore" Version="15.1.28" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.11.6" />
        <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
        <PackageReference Include="System.Reactive" Version="6.1.0" />
        <PackageReference Include="ZXing.Net.Bindings.ImageSharp.V2" Version="0.16.18" />
    </ItemGroup>

</Project>
